# Development-only values. Never reuse them outside a local machine.
DISCORDY_ENV=local
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
INTERNAL_SERVICE_TOKEN=dev-internal-token
# Ed25519 public key (PEM) matching the api's JWT_PRIVATE_KEY. `\n` escapes are accepted.
JWT_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAHth1IpE6T5hKAozMhW2qOAuZV9ONkWGHLHFNGhRP7dY=\n-----END PUBLIC KEY-----'
SNOWFLAKE_WORKER_ID=128
KAFKA_BROKERS=localhost:19092
VALKEY_URL=redis://localhost:6379
ETCD_ENDPOINTS=http://localhost:2379
TURN_STATIC_AUTH_SECRET=dev-turn-secret
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
API_INTERNAL_URL=http://localhost:8080
MESSAGES_INTERNAL_URL=http://localhost:8082
VOICE_TOKEN_SECRET=dev-voice-token-secret
PUBLIC_GATEWAY_URL=ws://localhost:8000/gateway
DEFAULT_VOICE_REGION=nl-home
E2EE_SETTINGS_UNAVAILABLE_POLICY=open
# ADMISSION_MEMORY_FRACTION=0.75
# MEMORY_LIMIT_BYTES=1073741824
# TRANSPORT_BACKLOG_LIMIT=2000
RELEASE_COOKIE=dev-release-cookie
# CLUSTER_DNS_QUERY=gateway-headless.discordy.svc.cluster.local
PORT=4000
