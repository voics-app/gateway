#!/bin/sh

# Erlang distribution: nodes are named gateway@<ip> so that libcluster's DNS strategy
# (CLUSTER_DNS_QUERY) can derive node names from the A records of the headless service.
# The cookie comes from RELEASE_COOKIE.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="gateway@${POD_IP:-$(hostname -i | awk '{print $1}')}"
